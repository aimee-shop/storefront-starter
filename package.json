{
  "name": "storefront-starter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3010",
    "build": "npm run apps:verify && next build",
    "start": "next start -p 3010",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "apps:verify": "tsx scripts/apps-verify-packages.ts",
    "apps:verify:fixture": "APPS_ALLOW_FIXTURE_TRUST=1 tsx scripts/apps-verify-packages.ts --fixture reference-signed --script-fixture reference-signed",
    "pack:release": "tsx scripts/pack-release.ts",
    "pack:release:check": "tsx scripts/pack-release.ts --check",
    "e2e": "playwright test --config=e2e/playwright.config.ts",
    "e2e:ui": "playwright test --config=e2e/playwright.config.ts --ui",
    "e2e:smoke": "playwright test --config=e2e/playwright.config.ts --grep @smoke",
    "e2e:report": "playwright show-report e2e/playwright-report",
    "lhci": "./scripts/lhci-ci.sh"
  },
  "dependencies": {
    "@aimee.shop/blocks": "0.0.3",
    "@aimee.shop/sdk": "0.16.0",
    "@base-ui/react": "^1.3.0",
    "@hookform/resolvers": "^5.4.0",
    "@stripe/react-stripe-js": "^5.6.1",
    "@stripe/stripe-js": "^8.11.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "next": "^16.2.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.80.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.0.8",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "jsdom": "^26.1.0",
    "postcss": "^8",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
