# -- Environment (omit or set to "production" for prod) --
# NEXT_PUBLIC_AIMEE_ENV=local

# Sandbox / preview hosts: keep crawlers off. Production merchant stores
# should leave this unset (or false) and set NEXT_PUBLIC_AIMEE_ENV=production.
# NEXT_PUBLIC_NOINDEX=true

# -- Core API URL --
NEXT_PUBLIC_CORE_API_URL=http://localhost:3000

# -- Store context --
NEXT_PUBLIC_STORE_ID=<your-store-id>

# -- Public site origin (used for sitemap.xml, robots.txt, canonical URLs) --
# Set to the deployed storefront origin in non-local environments
NEXT_PUBLIC_SITE_URL=http://localhost:3010

# -- Storefront API key (server-only -- do NOT prefix with NEXT_PUBLIC_) --
# Admin: Settings > API Keys > Create storefront key set (human copies the
# one-time .env block). Assign "Storefront (Default)" to the sk_ half.
# That preset includes payments:process and checkout:complete.
# Never put this value in NEXT_PUBLIC_* or a browser bundle.
AIMEE_API_KEY=<your-storefront-api-key>

# -- Payments service URL (server-only; optional) --
# Defaults to NEXT_PUBLIC_CORE_API_URL when a gateway fronts both. Local often:
# AIMEE_PAYMENTS_API_URL=http://localhost:3002
# AIMEE_PAYMENTS_API_URL=

# -- Publishable API key (browser-safe, pk_test_/pk_live_ prefix) --
# Create in admin: Settings > API Keys. Used by the client-side cart; never reuse AIMEE_API_KEY here.
NEXT_PUBLIC_AIMEE_PUBLISHABLE_KEY=<your-pk-publishable-key>

# -- Cognito (required for non-production environments) --
# NEXT_PUBLIC_AIMEE_COGNITO_USER_POOL_ID=
# NEXT_PUBLIC_AIMEE_COGNITO_CLIENT_ID=

# -- App platform: privileged remote scripts --
# Deploy-time origin allowlist for certified app scripts (server-only).
# Comma-separated HTTPS origins; certified manifest origins are intersected
# with this list. Empty or unset = no remote app script loads (fail closed).
# APPS_SCRIPT_ALLOWED_ORIGINS=https://scripts.example-app.com

# Extra restricted path prefixes (comma-separated absolute paths) added to the
# built-in checkout/account/auth defaults, e.g. locale-prefixed checkout routes.
# Restricted paths get a strict nonce CSP, which requires the route to be
# dynamically rendered (force-dynamic); a prerendered route listed here would
# lose hydration.
# APPS_EXTRA_RESTRICTED_PATH_PREFIXES=/en/checkout,/fr/checkout

# Additional HTTPS image origins for CSP img-src (comma-separated), e.g. a
# merchant image CDN. The core API origin is always included.
# NEXT_PUBLIC_IMAGE_ORIGINS=
